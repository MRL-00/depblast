{
  "name": "depblast",
  "version": "0.1.0",
  "description": "GitHub App that scans new npm dependencies in PRs for blast radius: transitive deps, license conflicts, bundle size, security advisories, and maintainer health.",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node lib/index.js",
    "dev": "tsc && node lib/index.js",
    "lint": "eslint src/ --ext .ts",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "probot": "^13.4.0",
    "npm-registry-fetch": "^17.1.0",
    "semver": "^7.6.3",
    "spdx-license-ids": "^3.0.18",
    "minimist": "^1.2.8",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/semver": "^7.5.8",
    "typescript": "^5.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.12",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
