# DepBlast GitHub App Configuration
# Copy this to .env and fill in values from your GitHub App registration

APP_ID=123456
PRIVATE_KEY_PATH=./private-key.pem
WEBHOOK_SECRET=your-webhook-secret-here

# Optional: Set to production URL when deployed
# APP_URL=https://depblast.example.com

# Log level: debug, info, warn, error
LOG_LEVEL=info
